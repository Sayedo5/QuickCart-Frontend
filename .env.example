# Base URL of the QuickCart backend API, including the version prefix, no trailing slash.
# Local dev on an Android emulator uses 10.0.2.2 instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io origin — the backend root, WITHOUT /api/v1.
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# development | staging | production — controls the app name and bundle id.
EXPO_PUBLIC_APP_ENV=development

# EAS project id (from `eas init`) — enables OTA updates and push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Crash reporting. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps key for the Android live-tracking map (build-time only).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
