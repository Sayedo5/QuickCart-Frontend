# Base URL of the QuickCart backend API, including the version prefix, no trailing slash.
# Local dev on an Android emulator uses 10.0.2.2 instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.io origin — the backend root, WITHOUT /api/v1.
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# development | staging | production — controls the app name and bundle id.
EXPO_PUBLIC_APP_ENV=development

# EAS project id (from `eas init`) — enables OTA updates and push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Crash reporting. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps key for the Android live-tracking map (build-time only).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps — REQUIRED for the live order-tracking map to render on Android.
#
# This must be a key from YOUR OWN Google Cloud project with:
#   1. "Maps SDK for Android" enabled (NOT the Maps JavaScript API — different product)
#   2. billing enabled on the project
#   3. either no restriction, or an Android restriction listing the app's
#      package name (pk.quickcart.app) and the signing SHA-1 from
#      `eas credentials -p android`
#
# Without it the tracking screen falls back to the text ETA view by design.
# For EAS builds the key must also exist in the BUILD environment — a value in
# this file alone never reaches EAS servers. Set it with:
#   eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY --value <key> \
#     --environment production --visibility plaintext
